<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_menu_item_view_form" model="ir.ui.view">
        <field name="name">restaurant.menu.item.view.form</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                    <group>
                        <field name="price" />
                        <field name="category" />
                        <field name="is_available"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_menu_item_view_tree" model="ir.ui.view">
        <field name="name">restaurant.menu.item.view.tree</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="category" />
                <field name="is_available" />
            </tree>
        </field>
    </record>

    <record id="restaurant_menu_item_action" model="ir.actions.act_window">
        <field name="name">Restaurant Menu Items</field>
        <field name="res_model">restaurant.menu.item</field>
        <field name="view_mode">tree,form</field>
    </record>
    
</odoo>
