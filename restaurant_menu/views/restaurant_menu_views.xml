<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_menu_view_form" model="ir.ui.view">
        <field name="name">restaurant.menu.view.form</field>
        <field name="model">restaurant.menu</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="menu_item_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_menu_view_tree" model="ir.ui.view">
        <field name="name">restaurant.menu.view.tree</field>
        <field name="model">restaurant.menu</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="restaurant_menu_action" model="ir.actions.act_window">
        <field name="name">Restaurant Menus</field>
        <field name="res_model">restaurant.menu</field>
        <field name="view_mode">tree,form</field>
    </record>
    

</odoo>
